# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development            # development | production | testing
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets; print(secrets.token_hex(32))"
HOST=127.0.0.1
PORT=5000

# --- MySQL ---
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
DATABASE_URL=mysql+pymysql://unisphere:unisphere_dev_pw@localhost:3306/unisphere?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://unisphere:unisphere_dev_pw@localhost:3306/unisphere_test?charset=utf8mb4

# --- Uploaded images (must be a persistent directory / mounted volume in production) ---
UPLOAD_FOLDER=instance/uploads
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_LISTING=5

# --- Real-time chat ---
# eventlet (default, recommended) | threading
SOCKETIO_ASYNC_MODE=eventlet
# Only needed when running more than one worker/process, e.g. redis://localhost:6379/0
SOCKETIO_MESSAGE_QUEUE=
CHAT_POLL_INTERVAL_MS=8000

# --- Security (set true when served over HTTPS) ---
SESSION_COOKIE_SECURE=false

# --- Branding ---
DEFAULT_COLLEGE=Ness Wadia College of Commerce, Pune
